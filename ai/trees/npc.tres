[sub_resource type="BBVariant" id="FireValue"]
type = 21
saved_value = &"FIRE_TO_ESCAPE"
resource_name = "FIRE_TO_ESCAPE"

[sub_resource type="BTCheckVar" id="CheckFire"]
variable = &"desired_action"
value = SubResource("FireValue")
custom_name = "Intent is FIRE_TO_ESCAPE"

[sub_resource type="BTAction" id="SelectFirePosition"]
script = ExtResource("3_select_fire")
output_var = &"fire_move_destination"

[sub_resource type="BTAction" id="MoveFirePosition"]
script = ExtResource("2_move")
position_var = &"fire_move_destination"
movement_reason = &"FIRE_TO_ESCAPE"
speed_mode = &"TACTICAL_WALK"

[sub_resource type="BTSequence" id="FireMovementCycle"]
custom_name = "Select and reach pressure position"
children = [SubResource("SelectFirePosition"), SubResource("MoveFirePosition")]

[sub_resource type="BTRepeat" id="RepeatFireMovement"]
forever = true
custom_name = "Keep tactical repositioning"
children = [SubResource("FireMovementCycle")]

[sub_resource type="BTAction" id="MaintainFireFacing"]
script = ExtResource("4_face")

[sub_resource type="BTAction" id="FireWhenValid"]
script = ExtResource("5_fire")

[sub_resource type="BTParallel" id="FireParallel"]
num_successes_required = 3
custom_name = "Move + face threat + fire opportunities"
children = [SubResource("RepeatFireMovement"), SubResource("MaintainFireFacing"), SubResource("FireWhenValid")]

[sub_resource type="BTDynamicSequence" id="FireBranch"]
custom_name = "FIRE_TO_ESCAPE"
children = [SubResource("CheckFire"), SubResource("FireParallel")]

[sub_resource type="BBVariant" id="EscapeValue"]
type = 21
saved_value = &"ESCAPE"
resource_name = "ESCAPE"

[sub_resource type="BTCheckVar" id="CheckEscape"]
variable = &"desired_action"
value = SubResource("EscapeValue")
custom_name = "Intent is ESCAPE"

[sub_resource type="BBVariant" id="TrueValue"]
type = 1
saved_value = true
resource_name = "true"

[sub_resource type="BTCheckVar" id="HasEscapeDestination"]
variable = &"has_escape_destination"
value = SubResource("TrueValue")
custom_name = "Has escape destination"

[sub_resource type="BTAction" id="MoveEscape"]
script = ExtResource("2_move")
position_var = &"escape_destination"
movement_reason = &"ESCAPE"
speed_mode = &"RUN"

[sub_resource type="BTDynamicSequence" id="EscapeBranch"]
custom_name = "ESCAPE"
children = [SubResource("CheckEscape"), SubResource("HasEscapeDestination"), SubResource("MoveEscape")]

[sub_resource type="BBVariant" id="BreakValue"]
type = 21
saved_value = &"BREAK_LOS"
resource_name = "BREAK_LOS"

[sub_resource type="BTCheckVar" id="CheckBreak"]
variable = &"desired_action"
value = SubResource("BreakValue")
custom_name = "Intent is BREAK_LOS"

[sub_resource type="BTAction" id="MoveBreakLOS"]
script = ExtResource("2_move")
position_var = &"selected_break_los_point"
movement_reason = &"BREAK_LOS"
speed_mode = &"RUN"
finish_when_los_lost = true

[sub_resource type="BTAction" id="ReevaluateAfterBreak"]
script = ExtResource("8_reevaluate")

[sub_resource type="BTDynamicSequence" id="BreakBranch"]
custom_name = "BREAK_LOS"
children = [SubResource("CheckBreak"), SubResource("MoveBreakLOS"), SubResource("ReevaluateAfterBreak")]

[sub_resource type="BBVariant" id="SurrenderValue"]
type = 21
saved_value = &"SURRENDER"
resource_name = "SURRENDER"

[sub_resource type="BTCheckVar" id="CheckSurrender"]
variable = &"desired_action"
value = SubResource("SurrenderValue")
custom_name = "Intent is SURRENDER"

[sub_resource type="BTAction" id="StopSurrender"]
script = ExtResource("6_stop")
reason = &"SURRENDERED"

[sub_resource type="BTAction" id="FaceOfficerSurrender"]
script = ExtResource("4_face")

[sub_resource type="BTAction" id="MaintainSurrenderPose"]
script = ExtResource("7_pose")

[sub_resource type="BTParallel" id="SurrenderParallel"]
num_successes_required = 2
num_failures_required = 2
custom_name = "Face officer + maintain surrender pose"
children = [SubResource("FaceOfficerSurrender"), SubResource("MaintainSurrenderPose")]

[sub_resource type="BTDynamicSequence" id="SurrenderBranch"]
custom_name = "SURRENDER"
children = [SubResource("CheckSurrender"), SubResource("StopSurrender"), SubResource("SurrenderParallel")]

[sub_resource type="BTAction" id="StopIdle"]
script = ExtResource("6_stop")
reason = &"IDLE"

[sub_resource type="BTAction" id="MaintainIdlePose"]
script = ExtResource("7_pose")

[sub_resource type="BTSequence" id="IdleBranch"]
custom_name = "IDLE"
children = [SubResource("StopIdle"), SubResource("MaintainIdlePose")]

[sub_resource type="BTDynamicSelector" id="Root"]
custom_name = "Suspect intent execution"
children = [SubResource("FireBranch"), SubResource("EscapeBranch"), SubResource("BreakBranch"), SubResource("SurrenderBranch"), SubResource("IdleBranch")]

[resource]
description = "Suspect orchestration: explicit interruptible intent branches with visible movement, facing, firing and completion tasks."
blackboard_plan = SubResource("BlackboardPlan")
root_task = SubResource("Root")
